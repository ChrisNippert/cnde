[Icon Theme]
Name=cnde
Comment=cnde's own symbolic icons: rounded outlines
Inherits=Adwaita,hicolor
Directories=symbolic/actions,symbolic/apps,symbolic/categories,symbolic/devices,symbolic/status

[symbolic/actions]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions

[symbolic/apps]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[symbolic/categories]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Categories

[symbolic/devices]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices

[symbolic/status]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status
