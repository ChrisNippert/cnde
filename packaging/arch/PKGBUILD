# Split package: install only the parts you want.
#
#   cnde-compositor  the session itself (required by the rest)
#   cnde-shell       top bar, dock, overview search, quick settings
#   cnde-settings    the Settings app
#   cnde-icons       cnde's own symbolic icons (else Adwaita's are used)
#   cnde             all of the above
#
# Without cnde-shell, set autostart.shell = "" (or another bar) in
# ~/.config/cnde/config.toml. Without cnde-settings, the shell stops
# offering Settings; config.toml is still there to edit.
#
# Builds from the checkout this file lives in:
#   cd packaging/arch && makepkg -si

pkgbase=cnde-git
pkgname=(cnde-compositor cnde-shell cnde-settings cnde-icons cnde)
pkgver=0.1.0
pkgrel=1
pkgdesc="A small, configurable Wayland desktop"
arch=(x86_64 aarch64)
license=(GPL-3.0-or-later)
makedepends=(cargo git)
source=("cnde::git+file://$(realpath "$startdir/../..")")
sha256sums=(SKIP)

pkgver() {
    cd cnde
    printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd cnde
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd cnde
    cargo build --frozen --release --workspace
}

package_cnde-compositor() {
    pkgdesc="cnde's compositor: the session itself"
    depends=(libinput libxkbcommon mesa libdrm systemd-libs seatd)
    optdepends=('xorg-xwayland: X11 apps'
                'xdg-desktop-portal-gtk: file pickers and settings for apps'
                'xdg-desktop-portal-wlr: screen sharing'
                'cnde-shell: the top bar and dock'
                'cnde-icons: cnde-style icons on title bars')
    cd cnde
    install -Dm755 target/release/cnde-compositor -t "$pkgdir/usr/bin"
    install -Dm644 data/cnde.desktop -t "$pkgdir/usr/share/wayland-sessions"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_cnde-shell() {
    pkgdesc="cnde's shell: top bar, dock, overview search, quick settings"
    depends=(cnde-compositor libxkbcommon)
    optdepends=('cnde-settings: the Settings app'
                'cnde-icons: cnde-style icons')
    cd cnde
    install -Dm755 target/release/cnde-shell -t "$pkgdir/usr/bin"
}

package_cnde-settings() {
    pkgdesc="cnde's Settings app"
    depends=(cnde-compositor libxkbcommon)
    cd cnde
    install -Dm755 target/release/cnde-settings -t "$pkgdir/usr/bin"
    install -Dm644 data/cnde-settings.desktop -t "$pkgdir/usr/share/applications"
}

package_cnde-icons() {
    pkgdesc="cnde's symbolic icons"
    arch=(any)
    cd cnde
    install -dm755 "$pkgdir/usr/share/icons"
    cp -r icons/cnde "$pkgdir/usr/share/icons/cnde"
}

package_cnde() {
    pkgdesc="cnde desktop: compositor, shell, settings and icons"
    arch=(any)
    depends=(cnde-compositor cnde-shell cnde-settings cnde-icons)
}
